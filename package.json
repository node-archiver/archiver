{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "tsdown": "0.22.1"
    }
  },
  "type": "module",
  "scripts": {
    "u": "bun run --sequential format lint build test",
    "format": "oxfmt",
    "lint": "oxlint",
    "build": "bun run --parallel --filter='./packages/**' build",
    "test": "bun run --sequential --filter='./packages/**' test"
  },
  "devDependencies": {
    "@gameroman/config": "0.1.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.2",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@babel/helper-validator-identifier": "8.0.2",
    "@babel/parser": "8.0.0",
    "@types/node": "25.9.2"
  }
}
