{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "tsdown": "^0.21.4"
    }
  },
  "type": "module",
  "scripts": {
    "u": "bun format ; bun lint ; bun run build && bun run test",
    "format": "oxfmt",
    "lint": "oxlint",
    "build": "bun run --filter='./packages/**' build",
    "test": "bun run --filter='./packages/**' test"
  },
  "devDependencies": {
    "@gameroman/config": "^0.0.4",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3"
  }
}
