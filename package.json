{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "tsdown": "^0.21.7"
    }
  },
  "type": "module",
  "scripts": {
    "u": "bun run --sequential format lint build test",
    "format": "oxfmt",
    "lint": "oxlint",
    "build": "bun run --parallel --filter='./packages/**' build",
    "test": "bun run --sequential --filter='./packages/**' test"
  },
  "devDependencies": {
    "@gameroman/config": "^0.0.5",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2"
  }
}
