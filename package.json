{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "u": "bun run --sequential format lint build test",
    "format": "oxfmt",
    "lint": "oxlint",
    "build": "bun run --parallel --filter='./packages/**' build",
    "test": "bun run --sequential --filter='./packages/**' test"
  },
  "devDependencies": {
    "@gameroman/config": "0.2.6",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@types/node": "26.1.2"
  }
}
