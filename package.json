{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "tsdown": "0.22.3"
    }
  },
  "type": "module",
  "scripts": {
    "u": "bun run --sequential format lint build test",
    "format": "oxfmt",
    "lint": "oxlint",
    "build": "bun run --parallel --filter='./packages/**' build",
    "test": "bun run --sequential --filter='./packages/**' test"
  },
  "devDependencies": {
    "@gameroman/config": "0.2.5",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.5",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@types/node": "25.9.5"
  }
}
