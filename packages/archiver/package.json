{
  "name": "@archiver/archiver",
  "version": "0.1.0",
  "description": "a streaming interface for archive generation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-archiver/archiver.git",
    "directory": "packages/archiver"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./utils": "./dist/utils.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test --reporter dot",
    "bench": "bun benchmark/simple/pack-zip.js",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@archiver/readdir-glob": "workspace:*",
    "@archiver/tar-stream": "workspace:*",
    "@archiver/zip-stream": "workspace:*"
  },
  "devDependencies": {
    "@types/yauzl": "3.3.0",
    "stream-bench": "0.1.2",
    "tar": "7.5.16",
    "tsdown": "0.22.9",
    "yauzl": "3.3.2"
  },
  "engines": {
    "node": ">=24"
  }
}
