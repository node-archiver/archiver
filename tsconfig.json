{
  "extends": "@gameroman/config/ts/isolated",
  "compilerOptions": {
    // TODO: remove later
    "strict": false,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitAny": false,

    "types": ["node"]
  },
  "include": ["**/src/*.ts"]
}
